# ─── Database (PostgreSQL) ────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=schola

# ─── JWT / Auth ───────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
EMAIL_SALT=change-me-to-another-random-string

# ─── App ──────────────────────────────────────────────
APP_ENV=development
BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

