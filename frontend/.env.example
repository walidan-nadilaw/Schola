# Backend API Endpoint
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_API_TIMEOUT=30000

# Key Penyimpanan Token Autentikasi di LocalStorage
VITE_TOKEN_KEY=schola_token

# Konfigurasi Upload File (5 MB)
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png

# Feature Flags / Fitur Opsional
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_PDF_PREVIEW=false
